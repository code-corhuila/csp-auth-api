# Names and placeholders only: never a real value. Copy to .env for local runs.
# Every variable the service reads is listed here; the Pull Requests that add configuration add their names.
PORT=8081

# HTTP server limits (Go durations)
APP_AUTH_HTTP_READ_HEADER_TIMEOUT=5s
APP_AUTH_HTTP_READ_TIMEOUT=10s
APP_AUTH_HTTP_WRITE_TIMEOUT=15s
APP_AUTH_HTTP_IDLE_TIMEOUT=60s
APP_AUTH_HTTP_SHUTDOWN_TIMEOUT=15s

# PostgreSQL (schema auth) and its connection pool
APP_AUTH_DATABASE_URL=postgresql://user:password@localhost:5432/csp?search_path=auth
APP_AUTH_DATABASE_MAX_CONNECTIONS=10
APP_AUTH_DATABASE_QUERY_TIMEOUT=5s

# Redis (token blacklist and login attempts)
APP_AUTH_REDIS_URL=redis://localhost:6379/0
APP_AUTH_REDIS_TIMEOUT=2s

# JWT RS256: PEM contents injected by the environment, never committed
APP_AUTH_JWT_PRIVATE_KEY=
APP_AUTH_JWT_PUBLIC_KEY=
APP_AUTH_JWT_EXPIRY=1h
APP_AUTH_REFRESH_TOKEN_EXPIRY=168h

# Password hashing cost
APP_AUTH_BCRYPT_ROUNDS=12
