# Names and placeholders only: never a real value. Copy to .env for local runs.
PORT=8081

# HTTP server limits (Go durations)
APP_AUTH_HTTP_READ_HEADER_TIMEOUT=5s
APP_AUTH_HTTP_READ_TIMEOUT=10s
APP_AUTH_HTTP_WRITE_TIMEOUT=15s
APP_AUTH_HTTP_IDLE_TIMEOUT=60s
APP_AUTH_HTTP_SHUTDOWN_TIMEOUT=15s

# Request limits (Norma 5.3.10). The request timeout is the deadline of every request (at most 60s): one that waits for a
# pooled database connection answers 503 SERVICE_UNAVAILABLE when it ends. The detached deadline (at most 60s) bounds logout
# and role change once started. Sizes are in bytes.
APP_AUTH_HTTP_REQUEST_TIMEOUT=10s
APP_AUTH_DETACHED_DEADLINE=10s
APP_AUTH_HTTP_MAX_HEADER_BYTES=65536
APP_AUTH_MAX_BODY_BYTES=1048576
APP_AUTH_PASSWORD_RESET_MAX_BODY_BYTES=4096

# Bulkheads of POST /register and POST /login (bcrypt), each below APP_AUTH_DATABASE_MAX_CONNECTIONS; a full one answers 429 after 1s
APP_AUTH_REGISTER_MAX_CONCURRENCY=8
APP_AUTH_LOGIN_MAX_CONCURRENCY=8

# PostgreSQL (schema auth) and its connection pool (Go durations)
APP_AUTH_DATABASE_URL=postgresql://change-me:change-me@localhost:5432/change-me?search_path=auth
APP_AUTH_DATABASE_MAX_CONNECTIONS=10
APP_AUTH_DATABASE_MIN_CONNECTIONS=2
APP_AUTH_DATABASE_CONNECT_TIMEOUT=5s
APP_AUTH_DATABASE_QUERY_TIMEOUT=5s

# Password hashing cost (bcrypt, 4 to 31)
APP_AUTH_BCRYPT_ROUNDS=12

# JWT RS256 signing key: set exactly one of the next two (PEM, 2048 bits or more, never committed).
# Contents may use the two characters \n for newlines. Without a key the service does not publish /jwks.
APP_AUTH_JWT_PRIVATE_KEY=
APP_AUTH_JWT_PRIVATE_KEY_FILE=
# Access token lifetime (integer seconds, 1 to 3600; 900 = 15 minutes, ADR-054)
APP_AUTH_JWT_EXPIRY=900
# Refresh token lifetime (integer seconds, positive; 7 days)
APP_AUTH_REFRESH_TOKEN_EXPIRY=604800
# Grace window of the reuse detection of refresh tokens (integer seconds, 1 to 60; ADR-029)
APP_AUTH_REFRESH_REUSE_GRACE=10

# Internal operations (ADR-020): subjects (`sub`) of the service tokens allowed to call them, separated by commas.
# Empty means no service is allowed: every valid token receives 403.
SERVICE_SUBJECTS=csp-worker

# Redis of the auth state (ADR-028): the list of revoked access tokens of the logout and the login attempt counters. The URL names the auth_app
# user of csp-infra-redis; the password is URL-safe. Without the URL the logout route is not enabled.
# The timeout (Go duration) bounds the connection, every read and every write.
APP_AUTH_REDIS_URL=redis://auth_app:change-me@localhost:6379/0
APP_AUTH_REDIS_TIMEOUT=2s

# Login attempt limit (HU-AUTH-005, ADR-040), only with Redis: this many failed logins from one client address inside the window lock
# that address for the lock time; the next attempt is 429 TOO_MANY_REQUESTS with Retry-After. Window and lock are Go durations.
APP_AUTH_LOGIN_MAX_ATTEMPTS=10
APP_AUTH_LOGIN_WINDOW=5m
APP_AUTH_LOGIN_LOCK=5m
# Slowdown per account (HU-AUTH-005, ADR-059), only with Redis: after this many failed logins for one email inside the window, from
# any address, every further failed login of that email waits the delay before it answers 401. The account is never locked.
# Window and delay are Go durations (at most 24h and 5s).
APP_AUTH_LOGIN_ACCOUNT_SLOW_AFTER=20
APP_AUTH_LOGIN_ACCOUNT_WINDOW=1h
APP_AUTH_LOGIN_ACCOUNT_DELAY=1s
# Bound of the login limiter against Redis (HU-AUTH-005, ADR-048): the most one call waits, and how long the limiter is
# not called after a failure, so that a login stays fast during a Redis outage. Go durations (at most 5s and 5m).
APP_AUTH_LOGIN_LIMIT_TIMEOUT=300ms
APP_AUTH_LOGIN_LIMIT_PAUSE=10s

# Change of the own password (HU-AUTH-007, ADR-051): POST /me/password. With Redis, this many wrong current passwords of one user
# inside the window lock the change of that user for the lock time (429 TOO_MANY_REQUESTS with Retry-After); window and lock are Go
# durations. The limiter uses the timeout and the pause of the login limiter above.
APP_AUTH_PASSWORD_CHANGE_MAX_ATTEMPTS=5
APP_AUTH_PASSWORD_CHANGE_WINDOW=15m
APP_AUTH_PASSWORD_CHANGE_LOCK=15m
# Bulkhead of the route (Norma 5.3.10): concurrent requests (below the database pool) and the wait for a free slot (Go duration, at
# most 5s).
APP_AUTH_PASSWORD_CHANGE_MAX_CONCURRENCY=4
APP_AUTH_PASSWORD_CHANGE_QUEUE_TIMEOUT=1s

# SMTP relay that delivers the email verification code (ADR-034). Without a host the email change routes
# (PATCH /me/email, POST /me/email/verify) are not enabled. FROM is required when the host is set. USER and
# PASSWORD are optional and are provided as secrets in qa and main. TLS is starttls (default) or none, which is
# for a local catcher only. The timeout (Go duration) bounds the whole exchange.
APP_AUTH_SMTP_HOST=
APP_AUTH_SMTP_PORT=587
APP_AUTH_SMTP_USER=
APP_AUTH_SMTP_PASSWORD=
APP_AUTH_SMTP_FROM=
APP_AUTH_SMTP_TLS=starttls
APP_AUTH_SMTP_TIMEOUT=5s
# Bulkhead of PATCH /me/email (Norma 5.3.10): concurrent requests (below the database pool) and the wait for a free slot.
APP_AUTH_EMAIL_CHANGE_MAX_CONCURRENCY=4
APP_AUTH_EMAIL_CHANGE_QUEUE_TIMEOUT=1s

# Password reset (HU-AUTH-006, ADR-050): POST /forgot-password and POST /reset-password are public and need the SMTP relay above
# and this URL, the page of the portal that receives the token in the fragment (the message carries <URL>#token=<token>);
# without either of them the two routes answer 404. It is an absolute http(s) URL without a fragment.
APP_AUTH_PASSWORD_RESET_URL=
# Bulkhead of each of the two routes (Norma 5.3.10): concurrent requests (below the database pool) and the wait for a free slot
# (Go duration, at most 5s).
APP_AUTH_PASSWORD_RESET_MAX_CONCURRENCY=4
APP_AUTH_PASSWORD_RESET_QUEUE_TIMEOUT=1s
