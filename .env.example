# Names and placeholders only: never a real value. Copy to .env for local runs.
PORT=8081

# HTTP server limits (Go durations)
APP_AUTH_HTTP_READ_HEADER_TIMEOUT=5s
APP_AUTH_HTTP_READ_TIMEOUT=10s
APP_AUTH_HTTP_WRITE_TIMEOUT=15s
APP_AUTH_HTTP_IDLE_TIMEOUT=60s
APP_AUTH_HTTP_SHUTDOWN_TIMEOUT=15s

# PostgreSQL (schema auth) and its connection pool (Go durations)
APP_AUTH_DATABASE_URL=postgresql://change-me:change-me@localhost:5432/change-me?search_path=auth
APP_AUTH_DATABASE_MAX_CONNECTIONS=10
APP_AUTH_DATABASE_MIN_CONNECTIONS=2
APP_AUTH_DATABASE_CONNECT_TIMEOUT=5s
APP_AUTH_DATABASE_QUERY_TIMEOUT=5s

# Password hashing cost (bcrypt, 4 to 31)
APP_AUTH_BCRYPT_ROUNDS=12

# JWT RS256 signing key: set exactly one of the next two (PEM, 2048 bits or more, never committed).
# Contents may use the two characters \n for newlines. Without a key the service does not publish /jwks.
APP_AUTH_JWT_PRIVATE_KEY=
APP_AUTH_JWT_PRIVATE_KEY_FILE=
# Access token lifetime (integer seconds, 1 to 3600)
APP_AUTH_JWT_EXPIRY=3600
# Refresh token lifetime (integer seconds, positive; 7 days)
APP_AUTH_REFRESH_TOKEN_EXPIRY=604800
# Grace window of the reuse detection of refresh tokens (integer seconds, 1 to 60; ADR-029)
APP_AUTH_REFRESH_REUSE_GRACE=10

# Internal operations (ADR-020): subjects (`sub`) of the service tokens allowed to call them, separated by commas.
# Empty means no service is allowed: every valid token receives 403.
SERVICE_SUBJECTS=csp-worker

# Redis of the auth state (ADR-028): the list of revoked access tokens of the logout and the login attempt counters. The URL names the auth_app
# user of csp-infra-redis; the password is URL-safe. Without the URL the logout route is not enabled.
# The timeout (Go duration) bounds the connection, every read and every write.
APP_AUTH_REDIS_URL=redis://auth_app:change-me@localhost:6379/0
APP_AUTH_REDIS_TIMEOUT=2s

# Login attempt limit (HU-AUTH-005, ADR-040), only with Redis: this many failed logins from one client address inside the window lock
# that address for the lock time; the next attempt is 429 RATE_LIMITED with Retry-After. Window and lock are Go durations.
APP_AUTH_LOGIN_MAX_ATTEMPTS=10
APP_AUTH_LOGIN_WINDOW=5m
APP_AUTH_LOGIN_LOCK=5m

# SMTP relay that delivers the email verification code (ADR-034). Without a host the email change routes
# (PATCH /me/email, POST /me/email/verify) are not enabled. FROM is required when the host is set. USER and
# PASSWORD are optional and are provided as secrets in qa and main. TLS is starttls (default) or none, which is
# for a local catcher only. The timeout (Go duration) bounds the whole exchange.
APP_AUTH_SMTP_HOST=
APP_AUTH_SMTP_PORT=587
APP_AUTH_SMTP_USER=
APP_AUTH_SMTP_PASSWORD=
APP_AUTH_SMTP_FROM=
APP_AUTH_SMTP_TLS=starttls
APP_AUTH_SMTP_TIMEOUT=5s
